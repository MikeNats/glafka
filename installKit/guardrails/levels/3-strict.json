{
  "level": 3,
  "name": "strict",
  "note": "Same as standard, plus: the internet becomes a named list, shell strings are refused, and anything not recognised is denied instead of allowed. Still no container needed. Expect to add a host or a command here and there in the first week.",
  "failClosed": true,
  "onUnknownAction": "deny",
  "audit": {
    "enabled": true,
    "path": "$stateDir/audit/$ticketId.jsonl",
    "redactFields": ["content", "newString", "oldString", "prompt"],
    "redactEnvMatching": [
      "SECRET",
      "TOKEN",
      "PASS",
      "PWD",
      "KEY",
      "CREDENTIAL",
      "AUTH",
      "DATABASE_URL",
      "DSN",
      "CONNECTION_STRING",
      "PRIVATE",
      "SALT",
      "SESSION",
      "COOKIE",
      "WEBHOOK"
    ]
  },
  "filesystem": {
    "enabled": true,
    "allowRoots": ["TICKET_WORKTREE", "TICKET_SCRATCH"],
    "denyWithin": [
      ".git",
      ".git/hooks/**",
      ".git/config",
      ".git/info/exclude",
      "**/.env",
      "**/.env.*",
      ".glafka.json",
      "docs/glafka/guardrails.json",
      "docs/glafka/architecture/isolation.json",
      "docs/glafka/ethos/**",
      "**/node_modules/.bin/**",
      ".claude/**",
      ".gemini/**",
      ".cursor/**",
      ".opencode/**",
      ".kimi/**",
      ".kimi-code/**",
      ".github/skills/**",
      ".github/hooks/**",
      ".glafka",
      ".glafka/**",
      "**/node_modules/**"
    ],
    "followSymlinks": true
  },
  "exec": {
    "enabled": true,
    "allowShellStrings": false,
    "allow": [
      {
        "cmd": "node",
        "anyArgs": true,
        "denyArgs": ["-e", "--eval", "-p", "--print"]
      },
      {
        "cmd": "npm",
        "subcommands": ["run", "ci", "install", "test", "ls", "why"],
        "denyArgs": ["-g", "--global"]
      },
      {
        "cmd": "npx",
        "anyArgs": true,
        "denyArgs": ["-y", "--yes", "-g", "--global"]
      },
      {
        "cmd": "pnpm",
        "anyArgs": true,
        "denyArgs": ["-g", "--global"]
      },
      {
        "cmd": "yarn",
        "anyArgs": true,
        "denyArgs": ["-g", "--global"]
      },
      {
        "cmd": "python3",
        "anyArgs": true,
        "denyArgs": ["-c", "-m"]
      },
      {
        "cmd": "uv",
        "subcommands": ["run", "sync", "add", "remove", "lock"]
      },
      {
        "cmd": "pytest",
        "anyArgs": true
      },
      {
        "cmd": "git",
        "subcommands": [
          "status",
          "diff",
          "log",
          "show",
          "add",
          "commit",
          "rev-parse",
          "branch",
          "checkout",
          "switch",
          "restore",
          "stash",
          "ls-files",
          "rebase",
          "rm",
          "mv"
        ],
        "denyArgs": ["--hard", "--force", "-f"]
      },
      {
        "cmd": "rg",
        "anyArgs": true
      },
      {
        "cmd": "ls",
        "anyArgs": true
      },
      {
        "cmd": "cat",
        "anyArgs": true
      },
      {
        "cmd": "mkdir",
        "anyArgs": true
      },
      {
        "cmd": "cp",
        "anyArgs": true
      },
      {
        "cmd": "mv",
        "anyArgs": true
      },
      {
        "cmd": "make",
        "anyArgs": true
      },
      {
        "cmd": "touch",
        "anyArgs": true
      },
      {
        "cmd": "echo",
        "anyArgs": true
      },
      {
        "cmd": "glafka",
        "subcommands": [
          "aporia",
          "krisis",
          "epalitheusis",
          "psyche",
          "apofasi",
          "guardrails",
          "ergon"
        ]
      }
    ],
    "never": [
      "git push",
      "git remote",
      "git config",
      "gh",
      "gh pr create",
      "gh pr merge",
      "gh release create",
      "npm exec",
      "npm x",
      "pnpm dlx",
      "yarn dlx",
      "npm publish",
      "pnpm publish",
      "yarn publish",
      "cargo publish",
      "twine upload",
      "docker push",
      "kubectl",
      "terraform",
      "helm",
      "ssh",
      "scp",
      "rsync",
      "curl",
      "wget"
    ]
  },
  "network": {
    "enabled": true,
    "mode": "allowlist",
    "allowHosts": [
      "registry.npmjs.org",
      "pypi.org",
      "files.pythonhosted.org",
      "github.com",
      "api.github.com",
      "objects.githubusercontent.com"
    ]
  },
  "secrets": {
    "enabled": true,
    "keepEnv": [
      "PATH",
      "HOME",
      "LANG",
      "LC_ALL",
      "TERM",
      "TMPDIR",
      "SHELL",
      "USER",
      "NODE_ENV",
      "CI",
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "CLAUDE_CODE_OAUTH_TOKEN",
      "CLAUDE_CONFIG_DIR",
      "GLAFKA_TICKET_ID",
      "GLAFKA_PORT",
      "ANTHROPIC_BASE_URL",
      "OPENAI_API_KEY",
      "OPENAI_BASE_URL",
      "GEMINI_API_KEY",
      "GOOGLE_API_KEY",
      "MOONSHOT_API_KEY",
      "OPENROUTER_API_KEY",
      "CURSOR_API_KEY",
      "GITHUB_TOKEN"
    ]
  },
  "sandbox": {
    "enabled": false,
    "backend": "none",
    "image": null,
    "network": true,
    "extraMounts": []
  },
  "override": {
    "mayNarrow": [
      "filesystem.denyWithin",
      "exec.allow",
      "exec.never",
      "network.allowHosts",
      "secrets.keepEnv",
      "audit.redactEnvMatching",
      "hostexec.hostExecutingPatterns"
    ],
    "mayWiden": ["exec.allow", "network.allowHosts", "secrets.keepEnv"],
    "neverOverridable": [
      "level",
      "failClosed",
      "onUnknownAction",
      "audit.enabled",
      "filesystem.allowRoots",
      "filesystem.followSymlinks",
      "exec.allowShellStrings",
      "exec.never"
    ]
  },
  "hostexec": {
    "flagHostExecutingChanges": true,
    "hostExecutingPatterns": []
  }
}
