{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "allowJs": false,
    "strict": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["installKit/bin/**/*", "src/**/*", "installKit/guardrails/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", ".worktrees", ".glafka-scratch"]
}
