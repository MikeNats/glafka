{
  "name": "glafka",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Michail Tsougkranis",
  "description": "Agentic coding-agent workflow orchestrator, an LLM agent that plans and writes code autonomously in a structured manner, with a human in the loop.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeNats/glafka.git"
  },
  "homepage": "https://github.com/MikeNats/glafka#readme",
  "bugs": "https://github.com/MikeNats/glafka/issues",
  "type": "module",
  "bin": {
    "glafka": "./dist/installKit/bin/glafka.js"
  },
  "files": [
    "dist",
    "installKit",
    "!installKit/bin",
    "!installKit/guardrails"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node scripts/run-all-tests.mjs",
    "pretest": "npm run build",
    "test:fast": "node scripts/select-fast-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
